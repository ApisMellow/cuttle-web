# /etc/cuttle/cuttle.env: copy from this example, mode 0640, root:cuttle.
# Read by the systemd unit (EnvironmentFile). No secrets belong here; the
# server has none. Flags in the unit's ExecStart win over these values.

# Web origins allowed to call the API and open the WebSocket, comma-separated,
# exact scheme://host with no path, no trailing slash, no wildcard. Your own
# hostname first, then the GitHub Pages site.
CUTTLE_ALLOWED_ORIGINS=https://cuttle.example.com,https://apismellow.github.io

# Where the nightly database copy goes. Create it 0700 and owned by the
# service user first (setup.sh does): the server refuses a looser existing
# directory at startup.
CUTTLE_BACKUP_DIR=/var/backups/cuttle

# Public origin of this droplet. Read by update.sh only (the server ignores
# it): it is baked into the web app that Caddy serves from this machine, so
# Play online talks to the same host. Leave it out to build without it.
CUTTLE_PUBLIC_ORIGIN=https://cuttle.example.com

# Optional tuning; the defaults are the SPEC section 2.12.6 limits.
#CUTTLE_CREATE_PER_HOUR=10
#CUTTLE_JOIN_PER_HOUR=30
#CUTTLE_MAX_ROOMS=500
#CUTTLE_RESPOND_MIN_MS=1500
#CUTTLE_MAX_SOCKETS=500
#CUTTLE_MAX_SOCKETS_PER_CLIENT=8
